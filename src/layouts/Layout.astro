---
import { getEntry } from 'astro:content';
import Menu from '../components/Menu.astro';
import Seo from '../components/SeoHead.astro';
import '../css/reset.css';
import '../css/base.css';

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;

// ★ Layoutが受け取るPropsの型定義
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

// Propsを分割代入で受け取る（デフォルト値もお好みで設定可能）
const {
  title = settings?.siteTitle || 'サイト名', // 設定ファイル等からデフォルトタイトルを引っ張るのもおすすめ
  description = settings?.desc,
  image = '/images/ogp.png', // デフォルトのOGP画像（publicフォルダ等に配置）
  type = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<link rel="icon" type="image/svg+xml" href={settings?.favicon || '/favicon.svg'} />
		<Seo 
			title={title} 
			description={description} 
			image={image} 
			type={type} 
		/>
	</head>
	<body>
		<div class="wrapper">
			<div class="flex-wrapper">
				<div class="main">
					<slot />
				</div>
				<div class="hero-header"><img src={settings?.headerImage} alt="ヘッダー"></div>
			</div>
			<Menu />
		</div>
	</body>
</html>
