---
const { entry } = Astro.props as { entry: any };
const defaultName = entry.data.defaultName;
---

<script define:vars={{ defaultName }}>
const name =
  localStorage.getItem("dreamName") || defaultName;

document.querySelectorAll("[data-replace]").forEach(el => {
  el.innerHTML = el.innerHTML.replaceAll("{{name}}", name);
});

window.addEventListener("storage", () => {
  location.reload();
});
</script>