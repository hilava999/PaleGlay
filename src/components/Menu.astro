---
import { getEntry } from 'astro:content';
import Sns from "../components/Sns.astro";

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;
---

<div class="h-menu-container">
    <div class="h-menu">
        <a href="/"><h1 class="logo">{settings?.siteTitle}</h1></a>
        <ul class="h-menu-list">
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/dream">Dream</a></li>
            <li><a href="/memo">Memo</a></li>
        </ul>
        <Sns />
    </div>

    <button class="menu-toggle" aria-label="Menu">
      <div class="menu-span">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </button>
</div>

<style>
body.menu-open {
  overflow: hidden;
}

.h-menu-container {
    position: fixed;
}


.h-menu {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
}

.menu-toggle {
  border-radius: 0;
  position: fixed;
  display: none;
  border: none;
  cursor: pointer;
  width: 35px;
  height: 35px;
  background-color:rgba(255, 255, 255, 0.8);
  z-index: 9999;
  top: 15px;
  right: 10px;
}

.menu-span  span{
display: block;
  width: 24px;
  height: 2px;
  background: #333;
  margin: 5px 0;
  transition: .3s;
  z-index: 9999;
}

.menu-span {
    position: fixed;
    top: 19px;
    right: 15px;
}

.menu-toggle.active span:nth-child(1) {
  transform: rotate(45deg) translate(5px, 5px);
}

.menu-toggle.active span:nth-child(2) {
  opacity: 0;
}

.menu-toggle.active span:nth-child(3) {
  transform: rotate(-45deg) translate(6px, -6px);
}

@media (max-width: 768px) {
    .logo {
        font-size: 28px;
        color: #000;
        font-family: "Cardo", serif;
        font-weight: 700;
        font-style: normal;
        padding: 10px 0;
    }

    .h-menu {
        display: block;
        position: fixed;
        top: 9%;
        right: -100%;
        height:auto;
        width: 90%;
        flex-direction: column;
        padding: 3rem 2rem;
        transition: right .3s ease;
        z-index: 9999;
        background-color:rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(8px);
    }
    .h-menu-list {
        display: flex;
    }

    .h-menu-list li {
        font-size: 18px;
        margin-right: 20px;
    }

    .h-menu-list li a:hover {
        opacity: 0.5;
    }

    .h-menu-list li:nth-child(1) a { transition-delay: 0.5s; }
    .h-menu-list li:nth-child(2) a { transition-delay: 0.8s; }
    .h-menu-list li:nth-child(3) a { transition-delay: 1.1s; }
    .h-menu-list li:nth-child(4) a { transition-delay: 1.4s; }

    .h-menu.active {
        right: 0;
    }

    .menu-toggle {
        display: block;
    }
}

@media (max-width: 500px) {
    .logo {
        font-size: 24px;
    }

}
</style>

<script>
  // 1. 要素を確実に取得し、HTML要素であることを明示する
  const toggle = document.querySelector(".menu-toggle") as HTMLElement;
  const nav = document.querySelector(".h-menu") as HTMLElement;

  // 2. 要素が存在する場合のみ処理を実行する（「!」や「if」でチェック）
  if (toggle && nav) {
    document.querySelectorAll(".h-menu-list a").forEach(link => {
      link.addEventListener("click", () => {
        nav.classList.remove("active");
        toggle.classList.remove("active");
        document.body.classList.remove("menu-open");
      });
    });

    toggle.addEventListener("click", () => {
      nav.classList.toggle("active");
      toggle.classList.toggle("active");
      document.body.classList.toggle("menu-open");
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Node; // 型をNodeとして明示
      const isMenuOpen = nav.classList.contains("active");

      if (
        isMenuOpen &&
        !nav.contains(target) &&
        !toggle.contains(target)
      ) {
        nav.classList.remove("active");
        toggle.classList.remove("active");
        document.body.classList.remove("menu-open");
      }
    });
  }
</script>
