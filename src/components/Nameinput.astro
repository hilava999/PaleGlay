<div id="modal" class="modal hidden">
  <div class="modal-content">
    <p><span data-name></span>さま、よい夢を。</p>
    <button id="closeModal" class="btn">Close</button>
  </div>
</div>

<style>
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .hidden {
        display: none;
    }

    .modal-content {
        background: white;
        padding: 40px 60px;
        border-radius: 12px;
        text-align: center;
    }

    .modal:not(.hidden) {
        opacity: 1;
    }

    .modal-content p {
        padding: 5px 0;
    }

    .btn {
        font-size: 14px;
        margin: 20px 0 0;
    }
</style>


<script>
const input = document.getElementById("dreamName") as HTMLInputElement | null;
const button = document.getElementById("saveName") as HTMLButtonElement | null;

const modal = document.getElementById("modal") as HTMLElement | null;
const closeBtn = document.getElementById("closeModal") as HTMLButtonElement | null;

// 🔶 名前反映
function applyName(name: string) {
  document.querySelectorAll("[data-name]").forEach(el => {
    el.textContent = name;
  });
}

// 🔶 初期表示
const savedName = localStorage.getItem("dreamName") || "あなた";
applyName(savedName);

// 🔶 nullチェックしてから使う（重要）
if (button && input && modal && closeBtn) {

  button.addEventListener("click", () => {
    const name = input.value || "あなた";

    localStorage.setItem("dreamName", name);
    applyName(name);

    modal.classList.remove("hidden");
  });

  closeBtn.addEventListener("click", () => {
    modal.classList.add("hidden");
  });

  modal.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.classList.add("hidden");
    }
  });

}
</script>