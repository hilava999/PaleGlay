---
import { getEntry } from 'astro:content';

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;
---

<div class="menu-wrapper">
    <a href="/"><h1 class="logo">{settings?.siteTitle}</h1></a>
    <ul class="menu-list">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/dream">Dream</a></li>
        <li><a href="/memo">Memo</a></li>
    </ul>
</div>

<style>
    .menu-wrapper {
        position: relative;
        display: flex;
        justify-content: right;
    }

    .menu-list {
        display: flex;
    }

    .menu-list li {
        font-size: 18px;
        margin-right: 30px;
    }

    .logo {
        display: inline-block;
        position: fixed;
        top:2%;
        left: 40px;
        writing-mode: vertical-rl;
    }

    @media (max-width: 768px) {
        .menu-wrapper {
            display: block;
        }
        .logo {
            display: inline-block;
            position: absolute;
            writing-mode: horizontal-tb;
            left: 1%;
            top:3%;
        }
        .menu-list {
            display: none;
        }
    }
</style>