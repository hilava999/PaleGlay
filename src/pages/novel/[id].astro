---
import { getCollection, render,getEntry } from 'astro:content';
import Dreamname from '../../components/Dreamname.astro';
import '../../css/novel.css';
import '../../css/snviewer.min.css';
import '../../css/snviewer.custum.css';

export async function getStaticPaths() {
  const posts = await getCollection('novel');
  return posts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;

// ここ変える！！
const { entry } = Astro.props;

if (!entry) {
  throw new Error("Not found");
}

const { Content } = await render(entry);

// サイトのベースURL（本番環境のURLやサイトに合わせて変更してください）
const siteUrl = Astro.site ? Astro.site.toString() : 'https://example.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---


<!DOCTYPE html>
<html lang="ja">
<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <meta name="robots" content="noindex,nofollow,noarchive" />
        <meta name="description" content={settings?.desc} />
        <!-- OGP (Facebook, LinkedIn, Discordなど) -->
        <meta property="og:type" content="article" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={entry.data.title} />
        <meta property="og:description" content={settings?.desc} />
        <meta property="og:site_name" content={settings?.siteTitle} />
        <!-- X (Twitter) Card -->
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={settings?.siteTitle} />
        <meta name="twitter:description" content={settings?.desc} />
        <link rel="icon" type="image/svg+xml" href={settings?.favicon || '/favicon.svg'} />
		<title>{entry.data.title}</title>
</head>
<body>
    <div class="novel-wrapper" id="snv-app">
        <div class="novel-container">
            <div class="novel-header"><h1 class="novel-title" id="nvl-subtitle">{entry.data.title}</h1></div>
            <div class="novel-text" data-replace id="novel-body">
                <Content />
            </div>
            <div class="novel-footer">
                <p><a href="/dream">Back</a></p>
            </div>
        </div>
        <!-- ローディング画面 -->
        <div id="snv-loading" class="snv-loader-wrapper">
            <div class="snv-loading">
                <span>Loading...</span>
            </div>
        </div>
        <!-- /ローディング画面 -->
    </div>
    <Dreamname entry={entry} />
    <script>
        // パスは実際のプロジェクト構成に合わせて適宜調整してください
        import { SNViewerAppClass } from '../../scripts/snviewer.js';
        // スクリプトが読み込まれた後に確実に実行されるようになります
        const viewerApp = new SNViewerAppClass({
            return: '/dream',
        });
    </script>
</body>
</html>