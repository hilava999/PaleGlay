---
import { getEntry } from 'astro:content';
import  Layout  from "../layouts/Layout.astro";
import Top from '../components/TopMenu.astro';
import Sns from "../components/Sns.astro";

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;

const currentYear = new Date().getFullYear();
---

<Layout title={`About | ${settings?.siteTitle}`} type='article'>
    <Top />
	<div class="main-container">
        <h2 class="page-title">About</h2>
        <h3 class="h3-a">About This Site</h3>
        <p>{settings?.about}</p>
        <h2 class="h3-a">About Me</h2>
        <p>
            {settings?.prof.bio}
            <Sns />
        </p>
    </div>
    <div class="footer">© {currentYear} {settings?.prof.author}.</div>
</Layout>