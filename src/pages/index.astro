---
import { getEntry } from 'astro:content';
import  Layout  from "../layouts/Layout.astro";

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;

const pageTitle = `Home | ${settings?.siteTitle || 'イラストサイト'}`;
---

<Layout title={pageTitle}>
	<div class="title">
		<h1 class="site-title">{settings?.siteTitle}</h1>
		<h3 class="sub-title">{settings?.subTitle}</h3>
		<p>Lastupdate：{settings?.lastUpdate}</p>
		<ul class="top-menu">
			<li><a href="/">Home</a></li>
			<li><a href="/about">About</a></li>
			<li><a href="/dream">Dream</a></li>
			<li><a href="/memo">Memo</a></li>
		</ul>
	</div>
</Layout>

